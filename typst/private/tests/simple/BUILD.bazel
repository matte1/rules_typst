load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//typst:typst.bzl", "typst")
load("//typst:typst_package.bzl", "typst_package")

typst_package(
    name = "test_package",
    package_name = "example",
    srcs = [
        "package/src/lib.typ",
        "package/typst.toml",
    ],
    namespace = "test",
    strip_prefix = "package",
    version = "1.0.0",
)

filegroup(
    name = "smile",
    srcs = ["smile.svg"],
)

copy_file(
    name = "frown",
    src = ":smile",
    out = "frown.svg",
)

typst(
    name = "simple",
    src = "simple.typ",
    data = [
        ":frown",
        ":smile",
    ],
    packages = [":test_package"],
    visibility = ["//typst/private/tests:__pkg__"],
)

build_test(
    name = "build_test",
    targets = [
        ":simple",
    ],
)

# Determinism test: two separate targets from the same source must produce
# byte-identical PDFs (SOURCE_DATE_EPOCH=0 is set by default).
typst(
    name = "deterministic_a",
    src = "simple.typ",
    data = [
        ":frown",
        ":smile",
    ],
    packages = [":test_package"],
)

typst(
    name = "deterministic_b",
    src = "simple.typ",
    data = [
        ":frown",
        ":smile",
    ],
    packages = [":test_package"],
)

diff_test(
    name = "deterministic_test",
    file1 = ":deterministic_a",
    file2 = ":deterministic_b",
)
